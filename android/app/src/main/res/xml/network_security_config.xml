<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- KAIRO gateway (kairo_gateway) and Dreamview Plus are plain HTTP on
             the vehicle LAN. 10.0.2.2 is the host PC as seen from the Android
             emulator; add your PC's LAN IP here when using a real tablet. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.133</domain>
    </domain-config>
</network-security-config>
